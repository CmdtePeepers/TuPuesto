@model List<TuTienda.Models.ViewModels.IngresoPorVendedorVM>

@{
    ViewData["Title"] = "Ingresos por vendedor";
}

<p><a asp-action="Index">← Volver a Reportes</a></p>
<h1>Ingresos por vendedor</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label">Desde</label>
        <input type="date" name="fechaInicio" value="@ViewBag.FechaInicio" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Hasta</label>
        <input type="date" name="fechaFin" value="@ViewBag.FechaFin" class="form-control" />
    </div>
    <div class="col-auto d-flex align-items-end">
        <button type="submit" class="btn btn-danger">Filtrar</button>
    </div>
</form>

<div class="alert alert-light border">
    <strong>Total generado por todos los vendedores:</strong> S/ @(((decimal)ViewBag.TotalGeneral).ToString("0.00"))
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">No hay ventas registradas en este período.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Vendedor</th>
                <th>Cantidad de pedidos</th>
                <th>Total generado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fila in Model)
            {
                <tr>
                    <td>@fila.NombreVendedor</td>
                    <td>@fila.CantidadPedidos</td>
                    <td>S/ @fila.Total.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}
