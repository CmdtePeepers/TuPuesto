@model TuTienda.Models.Entities.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="tt-panel">

                <div class="tt-panel-header">
                    <h3><i class="bi bi-pencil-square me-2"></i>Editar Categoría</h3>
                </div>

                <div class="tt-panel-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Nombre" class="tt-form-label"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="tt-form-label"></label>
                            <input asp-for="Descripcion" class="form-control" />
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-dark"><i class="bi bi-arrow-left me-2"></i>Volver</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-pencil-square me-2"></i>Guardar</button>
                        </div>
                    </form>
                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}