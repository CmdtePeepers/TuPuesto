@model TuTienda.Models.Entities.Usuario

@{
    ViewData["Title"] = "Crear Usuario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="tt-panel">

                <div class="tt-panel-header">
                    <h3><i class="bi bi-person-plus-fill me-2"></i>Crear Usuario</h3>
                </div>

                <div class="tt-panel-body">

                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombres" class="tt-form-label"></label>
                                <input asp-for="Nombres" class="form-control" placeholder="Ingrese los nombres" />
                                <span asp-validation-for="Nombres" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellidos" class="tt-form-label"></label>
                                <input asp-for="Apellidos" class="form-control" placeholder="Ingrese los apellidos" />
                                <span asp-validation-for="Apellidos" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="tt-form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PasswordHash" class="tt-form-label"></label>
                            <input asp-for="PasswordHash" type="password" class="form-control" placeholder="********" />
                            <span asp-validation-for="PasswordHash" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RolId" class="tt-form-label"></label>
                            <select asp-for="RolId" class="form-select">
                                <option value="">Seleccione un rol</option>
                                <option value="1">Administrador</option>
                                <option value="2">Vendedor</option>
                                <option value="3">Cliente</option>
                            </select>
                            <span asp-validation-for="RolId" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="Activo" class="form-check-input" />
                            <label asp-for="Activo" class="form-check-label ms-2 fw-semibold">Usuario Activo</label>
                        </div>

                        <hr />

                        <h5 class="tt-form-seccion"><i class="bi bi-shop me-2"></i>Información de la Tienda</h5>

                        <div class="mb-3">
                            <label asp-for="NombreTienda" class="tt-form-label"></label>
                            <input asp-for="NombreTienda" class="form-control" placeholder="Nombre de la tienda" />
                            <span asp-validation-for="NombreTienda" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DescripcionTienda" class="tt-form-label"></label>
                            <textarea asp-for="DescripcionTienda" rows="3" class="form-control" placeholder="Descripción de la tienda"></textarea>
                            <span asp-validation-for="DescripcionTienda" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-dark"><i class="bi bi-arrow-left me-2"></i>Volver</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-person-plus-fill me-2"></i>Crear Usuario</button>
                        </div>
                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}