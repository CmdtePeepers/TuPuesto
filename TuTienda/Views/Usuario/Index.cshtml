@model IEnumerable<TuTienda.Models.Entities.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="container py-4">

    <div class="tt-panel">

        <div class="tt-panel-header">
            <h3>Gestión de Usuarios</h3>
            <a asp-action="Create" class="tt-btn-crear">
                Nuevo Usuario
            </a>
        </div>

        <div class="tt-panel-body">

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover align-middle tt-tabla">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Nombres)</th>
                            <th>@Html.DisplayNameFor(model => model.Apellidos)</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th>@Html.DisplayNameFor(model => model.RolId)</th>
                            <th>Estado</th>
                            <th>@Html.DisplayNameFor(model => model.NombreTienda)</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nombres</td>
                                <td>@item.Apellidos</td>
                                <td>@item.Email</td>
                                <td>@item.RolId</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="tt-badge-estado tt-badge-activo">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="tt-badge-estado tt-badge-inactivo">Inactivo</span>
                                    }
                                </td>
                                <td>@item.NombreTienda</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="tt-btn-accion tt-accion-editar" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="tt-btn-accion tt-accion-detalles" title="Detalles">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="tt-btn-accion tt-accion-eliminar" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </div>

</div>