@model TuTienda.Models.Entities.Usuario

@{
    ViewData["Title"] = "Detalles del Usuario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="tt-panel">

                <div class="tt-panel-header">
                    <h3><i class="bi bi-person-vcard-fill me-2"></i>Detalles del Usuario</h3>
                </div>

                <div class="tt-panel-body">

                    <div class="tt-info-box">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombres)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombres)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Apellidos)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Apellidos)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.RolId)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.RolId)</dd>

                            <dt class="col-sm-4">Estado</dt>
                            <dd class="col-sm-8">
                                @if (Model.Activo)
                                {
                                    <span class="tt-badge-estado tt-badge-activo"><i class="bi bi-check-circle-fill me-1"></i>Activo</span>
                                }
                                else
                                {
                                    <span class="tt-badge-estado tt-badge-inactivo"><i class="bi bi-x-circle-fill me-1"></i>Inactivo</span>
                                }
                            </dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.FechaRegistro)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaRegistro)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NombreTienda)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.NombreTienda)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DescripcionTienda)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.DescripcionTienda)</dd>
                        </dl>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-dark"><i class="bi bi-arrow-left me-2"></i>Volver</a>
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary"><i class="bi bi-pencil-square me-2"></i>Editar</a>
                    </div>

                </div>

            </div>

        </div>
    </div>

</div>