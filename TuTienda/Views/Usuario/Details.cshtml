
@model TuTienda.Models.Entities.Usuario

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<style>
    body {
        background: linear-gradient(135deg, #1f2937, #111827);
        min-height: 100vh;
    }

    .card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0, 0, 0, .35);
    }

    .card-header {
        background: linear-gradient(135deg, #991b1b, #dc2626);
        padding: 18px;
    }

        .card-header h3 {
            font-size: 1.4rem;
            font-weight: 700;
            margin: 0;
        }

    .card-body {
        background: #fff;
        padding: 28px;
    }

    .info-box {
        background: #ffffff;
        border-left: 5px solid #dc2626;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 5px 15px rgba(220,38,38,.10);
    }

    dt {
        color: #991b1b;
        font-weight: 700;
        margin-bottom: 10px;
    }

    dd {
        color: #111827;
        margin-bottom: 15px;
    }

    .badge {
        font-size: .9rem;
        padding: 8px 12px;
    }

    .btn-primary {
        background: #dc2626;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-primary:hover {
            background: #b91c1c;
            transform: translateY(-2px);
        }

    .btn-dark {
        background: #4b5563;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        transition: .3s;
    }

        .btn-dark:hover {
            background: #374151;
            transform: translateY(-2px);
        }

    hr {
        margin: 25px 0;
    }
</style>

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="card">

                <div class="card-header text-white">

                    <h3>
                        <i class="bi bi-person-vcard-fill me-2"></i>
                        Detalles del Usuario
                    </h3>

                </div>

                <div class="card-body">

                    <div class="info-box">

                        <dl class="row mb-0">

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Nombres)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Nombres)
                            </dd>

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Apellidos)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Apellidos)
                            </dd>

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Email)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Email)
                            </dd>

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.RolId)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.RolId)
                            </dd>

                            <dt class="col-sm-4">
                                Estado
                            </dt>
                            <dd class="col-sm-8">
                                @if (Model.Activo)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle-fill me-1"></i>
                                        Inactivo
                                    </span>
                                }
                            </dd>

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.FechaRegistro)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.FechaRegistro)
                            </dd>

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.NombreTienda)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.NombreTienda)
                            </dd>

                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.DescripcionTienda)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.DescripcionTienda)
                            </dd>

                        </dl>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index" class="btn btn-dark">
                            <i class="bi bi-arrow-left me-2"></i>
                            Volver
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model?.Id"
                           class="btn btn-primary">
                            <i class="bi bi-pencil-square me-2"></i>
                            Editar
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
