@model TuTienda.Models.Entities.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="tt-panel">

                <div class="tt-panel-header tt-header-peligro">
                    <h3><i class="bi bi-trash-fill me-2"></i>Eliminar Usuario</h3>
                </div>

                <div class="tt-panel-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        ¿Está seguro de que desea eliminar este usuario? Esta acción no se puede deshacer.
                    </div>

                    <div class="tt-info-box tt-info-peligro">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombres)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombres)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Apellidos)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Apellidos)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.RolId)</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(model => model.RolId)</dd>

                            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Activo)</dt>
                            <dd class="col-sm-8">
                                @if (Model.Activo)
                                {
                                    <span class="tt-badge-estado tt-badge-activo">Activo</span>
                                }
                                else
                                {
                                    <span class="tt-badge-estado tt-badge-inactivo">Inactivo</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <hr />

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-dark"><i class="bi bi-arrow-left me-2"></i>Cancelar</a>
                            <button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill me-2"></i>Eliminar Usuario</button>
                        </div>
                    </form>

                </div>

            </div>

        </div>
    </div>

</div>