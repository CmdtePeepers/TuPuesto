@{
    ViewData["Title"] = "Mensajes";
    var conversaciones = ViewBag.Conversaciones;
}
<link rel="stylesheet" href="~/css/mensajesList.css" asp-append-version="true" />

<div class="container py-4">
    <div class="ml-header">
        <h1 class="ml-titulo">Mensajes</h1>
        <div class="ml-subtitulo">Tus conversaciones con clientes y vendedores, en un solo lugar.</div>
    </div>

    @if (conversaciones == null || conversaciones.Count == 0)
    {
        <div class="ml-vacio">
            <div class="ml-vacio-icono">💬</div>
            Aún no tienes conversaciones. Cuando alguien te escriba, aparecerá aquí.
        </div>
    }
    else
    {
        foreach (var c in conversaciones)
        {
            bool noLeido = c.NoLeidos > 0;
            string inicial = string.IsNullOrEmpty(c.OtroUsuarioNombre) ? "?" : c.OtroUsuarioNombre.Substring(0, 1).ToUpper();

            <a class="ml-item @(noLeido ? "ml-no-leido" : "")" asp-action="Conversacion" asp-route-id="@c.OtroUsuarioId">
                <div class="ml-avatar">@inicial</div>
                <div class="ml-info">
                    <div class="ml-nombre">@c.OtroUsuarioNombre</div>
                    <div class="ml-preview">@c.UltimoMensaje</div>
                </div>
                <div class="ml-meta">
                    <div class="ml-fecha">@(((DateTime)c.Fecha).ToString("dd/MM HH:mm"))</div>
                    @if (noLeido)
                    {
                        <span class="ml-badge">@c.NoLeidos</span>
                    }
                </div>
            </a>
        }
    }
</div>