@model TuTienda.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión - TuTienda</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="layout">
        <div class="panel-marca">
            <div>
                <div class="marca-badge">Miles de ofertas todos los días</div>
                <div class="marca-brand">TuTienda</div>
                <div class="marca-tagline">El marketplace donde cientos de vendedores de todos los rubros ofrecen sus productos: moda, tecnología, hogar y más.</div>
            </div>
            <div class="marca-footer">Compra directo. Vende sin límites.</div>
        </div>

        <div class="panel-form">
            <div class="form-card">
                <div class="form-eyebrow">Bienvenido de nuevo</div>
                <h1 class="form-titulo">Iniciar sesión</h1>

                <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="campo">
                        <label asp-for="Email">Correo electrónico</label>
                        <input asp-for="Email" placeholder="tucorreo@ejemplo.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="campo">
                        <label asp-for="Password">Contraseña</label>
                        <input asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-ingresar">Ingresar</button>
                </form>

                <div class="form-footer">
                    ¿No tienes cuenta? <a asp-action="Register">Regístrate aquí</a>
                </div>
            </div>
        </div>
    </div>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>
