@model IEnumerable<TuTienda.Models.Entities.Pedido>

@{
    ViewData["Title"] = "Mis compras";
    var porCompra = Model.GroupBy(p => p.GrupoCompraId).OrderByDescending(g => g.First().FechaPedido);
}
<link rel="stylesheet" href="~/css/misCompras.css" asp-append-version="true" />
<h1>Mis compras</h1>

@if (!Model.Any())
{
    <div class="alert alert-light border">
        Aún no has hecho ninguna compra. <a asp-controller="Producto" asp-action="Index">Ver productos</a>
    </div>
}
else
{
    @foreach (var compra in porCompra)
    {
        <div class="mc-compra">
            <div class="mc-compra-fecha">Compra del @compra.First().FechaPedido.ToString("dd/MM/yyyy HH:mm")</div>
            @foreach (var pedido in compra)
            {
                <div class="mc-pedido-header">
                    <span>Pedido #@pedido.Id — @(pedido.Vendedor?.NombreTienda ?? pedido.Vendedor?.Nombres)</span>
                    <span>
                        <span class="badge-estado badge-@pedido.Estado">@pedido.Estado</span>
                        &nbsp; S/ @pedido.Total.ToString("0.00")
                    </span>
                </div>
                @foreach (var detalle in pedido.Detalles)
                {
                    <div class="mc-item">
                        <span>@detalle.Producto?.Nombre × @detalle.Cantidad</span>
                        <span>S/ @detalle.Subtotal.ToString("0.00")</span>
                    </div>
                }

                @if (pedido.Estado == TuTienda.Models.Enums.EstadoPedido.Pendiente)
                {
                    <a class="btn-contactar" asp-controller="Mensaje" asp-action="Conversacion"
                       asp-route-id="@pedido.VendedorId" asp-route-pedidoId="@pedido.Id">
                        <img src="~/imagenes/whatsap.png" alt="Chat" />
                        Contactar para anular
                    </a>
                }
            }
        </div>
    }
}
