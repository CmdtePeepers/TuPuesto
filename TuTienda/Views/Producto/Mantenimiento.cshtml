@model IEnumerable<TuTienda.Models.Entities.Producto>

@{
    ViewData["Title"] = "Mis Productos";
    var categoriasDisponibles = Model
        .Where(p => p.Categoria != null)
        .Select(p => p.Categoria!)
        .GroupBy(c => c.Id)
        .Select(g => g.First())
        .OrderBy(c => c.Nombre);
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="container py-4">

    <div class="tt-panel">

        <div class="tt-panel-header">
            <h3><i class="bi bi-box-seam-fill me-2"></i>Mis Productos</h3>
            <a asp-action="Create" class="tt-btn-crear">
                <i class="bi bi-plus-circle-fill me-2"></i>Nuevo Producto
            </a>
        </div>

        <div class="tt-panel-body">

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="tt-msg-vacio">
                    Aún no tienes productos registrados. Crea el primero con el botón "Nuevo Producto".
                </div>
            }
            else
            {
                <div class="tt-mant-buscador">
                    <input type="text" id="filtroNombre" placeholder="Buscar por nombre..." />
                    <select id="filtroCategoria">
                        <option value="0">Todas las categorías</option>
                        @foreach (var cat in categoriasDisponibles)
                        {
                            <option value="@cat.Id">@cat.Nombre</option>
                        }
                    </select>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle tt-tabla" id="tablaMisProductos">
                        <thead>
                            <tr>
                                <th>Imagen</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Precio</th>
                                <th>Stock</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr data-nombre="@p.Nombre.ToLower()" data-categoria="@p.CategoriaId">
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(p.ImagenUrl) ? "https://via.placeholder.com/60x60?text=Sin+img" : p.ImagenUrl)"
                                             alt="@p.Nombre"
                                             style="width:56px;height:56px;object-fit:cover;border-radius:8px;border:1px solid #f0e2dc;" />
                                    </td>
                                    <td class="text-start fw-semibold">@p.Nombre</td>
                                    <td>@(p.Categoria?.Nombre ?? "—")</td>
                                    <td>S/ @p.Precio.ToString("0.00")</td>
                                    <td>@p.Stock</td>
                                    <td>
                                        <span class="tt-badge-estado @(p.Activo ? "tt-badge-activo" : "tt-badge-inactivo")">
                                            @(p.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@p.Id" class="tt-btn-accion tt-accion-editar" title="Editar este producto">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@p.Id" class="tt-btn-accion tt-accion-detalles" title="Detalles">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@p.Id" class="tt-btn-accion tt-accion-eliminar" title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                        <form asp-action="CambiarActivo" asp-route-id="@p.Id" method="post" style="display:inline-block; margin-left:6px;">
                                            <button type="submit" class="tt-msg-btn @(p.Activo ? "tt-msg-btn-desmarcar" : "tt-msg-btn-marcar")">
                                                @(p.Activo ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div id="mensajeSinResultados" class="tt-msg-vacio" style="display:none;">
                        No se encontraron productos con ese nombre o categoría.
                    </div>
                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
    <script>
        (function() {
            const inputNombre = document.getElementById('filtroNombre');
            const selectCategoria = document.getElementById('filtroCategoria');
            const filas = document.querySelectorAll('#tablaMisProductos tbody tr');
            const mensajeVacio = document.getElementById('mensajeSinResultados');

            function aplicarFiltro() {
                const texto = inputNombre.value.trim().toLowerCase();
                const categoriaId = selectCategoria.value;
                let visibles = 0;

                filas.forEach(function(fila) {
                    const coincideNombre = fila.dataset.nombre.includes(texto);
                    const coincideCategoria = categoriaId === "0" || fila.dataset.categoria === categoriaId;

                    if (coincideNombre && coincideCategoria) {
                        fila.style.display = "";
                        visibles++;
                    } else {
                        fila.style.display = "none";
                    }
                });

                mensajeVacio.style.display = visibles === 0 ? "block" : "none";
            }

            inputNombre.addEventListener('input', aplicarFiltro);
            selectCategoria.addEventListener('change', aplicarFiltro);
        })();
    </script>
}