@model IEnumerable<TuTienda.Models.ViewModels.CategoriaConProductos>

@{
    ViewData["Title"] = "Productos";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/indexPro.css" asp-append-version="true" />
}

<h1>Productos</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
{
    <p><a asp-action="Create">+ Crear nuevo producto</a></p>
}

<form asp-action="Buscar" method="get" class="prod-buscador">
    <input type="text" name="nombre" placeholder="Busca lo que necesites: ropa, laptops, comida..." />
    <button type="submit">Buscar</button>
</form>

@if (!Model.Any())
{
    <div class="alert alert-light border">Aún no hay productos publicados en ninguna categoría.</div>
}
else
{
    @foreach (var seccion in Model)
    {
        <div class="cat-seccion">
            <div class="cat-header">
                <h2 class="cat-titulo">@seccion.Categoria.Nombre</h2>
                <a class="cat-vertodos" asp-action="Categoria" asp-route-id="@seccion.Categoria.Id">Ver todos →</a>
            </div>
            <div class="prod-grid">
                @foreach (var producto in seccion.Productos)
                {
                    <div class="prod-card">
                        <a asp-action="Details" asp-route-id="@producto.Id" style="text-decoration:none; color:inherit;">
                            <img src="@(string.IsNullOrEmpty(producto.ImagenUrl) ? "https://via.placeholder.com/200x140?text=Sin+imagen" : producto.ImagenUrl)" alt="@producto.Nombre" />
                        </a>
                        <div class="prod-card-body">
                            <div class="prod-card-nombre">@producto.Nombre</div>
                            <div class="prod-card-precio">S/ @producto.Precio.ToString("0.00")</div>
                            @if (producto.Stock > 0)
                            {
                                <form asp-controller="Carrito" asp-action="Agregar" method="post">
                                    <input type="hidden" name="productoId" value="@producto.Id" />
                                    <input type="hidden" name="cantidad" value="1" />
                                    <button type="submit" class="prod-card-btn">Agregar al carrito</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:0.8rem;">Sin stock</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
