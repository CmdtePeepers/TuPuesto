@model IEnumerable<TuTienda.Models.ViewModels.CategoriaConProductos>

@{
    ViewData["Title"] = "Productos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="container py-4">
    <h1 class="tt-seccion-titulo" style="border:none; padding:0; margin-bottom:1.5rem;">Productos</h1>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @await Html.PartialAsync("_CatalogoConBuscador", Model)
</div>