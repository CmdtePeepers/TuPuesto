@model TuTienda.Models.Entities.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
    bool hayStock = Model.Stock > 0 && Model.Activo;
}

@section Styles {
    <link rel="stylesheet" href="~/css/detailsPro.css" asp-append-version="true" />
}

<a class="dp-volver" asp-action="Index">← Volver a Productos</a>

<div class="dp-layout">
    <div class="dp-imagen-wrap">
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" alt="@Model.Nombre" />
        }
        else
        {
            <div class="dp-imagen-vacia">Sin imagen disponible</div>
        }
    </div>

    <div class="dp-info">
        @if (Model.Categoria != null)
        {
            <span class="dp-categoria">@Model.Categoria.Nombre</span>
        }

        <h1 class="dp-nombre">@Model.Nombre</h1>

        <div class="dp-precio">S/ @Model.Precio.ToString("0.00")</div>

        @if (hayStock)
        {
            <span class="dp-stock dp-stock-disponible">✓ @Model.Stock unidades disponibles</span>
        }
        else
        {
            <span class="dp-stock dp-stock-agotado">✕ Sin stock</span>
        }

        @if (!string.IsNullOrEmpty(Model.Descripcion))
        {
            <p class="dp-descripcion">@Model.Descripcion</p>
        }

        @if (Model.Vendedor != null)
        {
            <div class="dp-vendedor">
                <div class="dp-vendedor-icono">@((Model.Vendedor.NombreTienda ?? Model.Vendedor.Nombres).Substring(0, 1).ToUpper())</div>
                <div class="dp-vendedor-texto">
                    <small>Vendido por</small>
                    <strong>@(Model.Vendedor.NombreTienda ?? Model.Vendedor.Nombres)</strong>
                </div>
            </div>
        }

        <div class="dp-acciones">
            @if (hayStock)
            {
                <form asp-controller="Carrito" asp-action="Agregar" method="post">
                    <input type="hidden" name="productoId" value="@Model.Id" />
                    <input type="hidden" name="cantidad" value="1" />
                    <button type="submit" class="dp-btn-carrito">Agregar al carrito</button>
                </form>
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Cliente") && Model.VendedorId > 0)
            {
                <a asp-controller="Mensaje" asp-action="Conversacion"
                   asp-route-id="@Model.VendedorId" asp-route-productoId="@Model.Id"
                   class="dp-btn-contactar">
                    <img src="~/imagenes/whatsap.png" alt="" />
                    Contactar al vendedor
                </a>
            }
        </div>
    </div>
</div>
