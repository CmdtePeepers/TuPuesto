@model IEnumerable<TuTienda.Models.Entities.Producto>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = ViewBag.Titulo;
    int paginaActual = ViewBag.PaginaActual;
    int totalPaginas = ViewBag.TotalPaginas;
    int elementosPorPagina = ViewBag.ElementosPorPagina;
    int categoriaId = ViewBag.CategoriaId;
    bool puedeComprar = !(User.IsInRole("Administrador") || User.IsInRole("Vendedor"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/listPro.css" asp-append-version="true" />
}

<a class="lp-volver" asp-action="Index">← Volver a Productos</a>
<h1 class="lp-titulo">@ViewBag.Titulo</h1>

<form asp-action="Buscar" method="get" class="lp-filtro">
    <input type="text" name="nombre" value="@ViewBag.Nombre" placeholder="Buscar por nombre" />
    <select name="categoriaId">
        <option value="0">Todas las categorías</option>
        @foreach (var item in (SelectList)ViewBag.CategoriasFiltro)
        {
            <option value="@item.Value">@item.Text</option>
        }
    </select>
    <button type="submit">Filtrar</button>
</form>

@if (!Model.Any())
{
    <div class="lp-vacio">No se encontraron productos.</div>
}
else
{
    <div class="lp-grid">
        @foreach (var item in Model)
        {
            bool hayStock = item.Activo && item.Stock > 0;

            <div class="lp-card">
                <a asp-action="Details" asp-route-id="@item.Id">
                    <img class="lp-card-img"
                         src="@(string.IsNullOrEmpty(item.ImagenUrl) ? "https://via.placeholder.com/210x150?text=Sin+imagen" : item.ImagenUrl)"
                         alt="@item.Nombre" />
                </a>
                <div class="lp-card-body">
                    <div class="lp-card-nombre">@item.Nombre</div>
                    @if (!string.IsNullOrEmpty(item.Descripcion))
                    {
                        <div class="lp-card-desc">@item.Descripcion</div>
                    }
                    <div class="lp-card-precio">S/ @item.Precio.ToString("0.00")</div>

                    @if (hayStock)
                    {
                        <div class="lp-card-stock lp-stock-si">✓ Stock: @item.Stock</div>
                    }
                    else
                    {
                        <div class="lp-card-stock lp-stock-no">✕ Sin stock</div>
                    }

                    <div class="lp-card-acciones">
                        @if (hayStock && puedeComprar)
                        {
                            <form asp-controller="Carrito" asp-action="Agregar" method="post">
                                <input type="hidden" name="productoId" value="@item.Id" />
                                <input type="hidden" name="cantidad" value="1" />
                                <button type="submit" class="lp-btn-carrito">Agregar al carrito</button>
                            </form>
                        }
                        <div class="lp-links-gestion">
                            <a asp-action="Details" asp-route-id="@item.Id">Detalles</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPaginas > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Buscar"
                           asp-route-nombre="@ViewBag.Nombre" asp-route-categoriaId="@categoriaId"
                           asp-route-paginaActual="@i" asp-route-elementosPorPagina="@elementosPorPagina">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
    <p class="lp-total">Total de productos: @ViewBag.TotalRegistros</p>
}