@model TuTienda.Models.Entities.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="container py-4">
    <div class="tt-panel">
        <div class="tt-panel-header">
            <h3><i class="bi bi-pencil-square me-2"></i>Editar Producto</h3>
        </div>
        <div class="tt-panel-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoriaId" class="form-label">Categoría</label>
                        <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId"></select>
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Precio" class="form-label"></label>
                        <input asp-for="Precio" class="form-control" />
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Stock" class="form-label"></label>
                        <input asp-for="Stock" class="form-control" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 d-flex align-items-end pb-2">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Activo" />
                            <label class="form-check-label" asp-for="Activo"></label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="ImagenUrl" class="form-label">URL de imagen</label>
                        <input asp-for="ImagenUrl" class="form-control" />
                        <span asp-validation-for="ImagenUrl" class="text-danger"></span>
                    </div>
                </div>

                <hr />

                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle-fill me-2"></i>Guardar Cambios</button>
                <a asp-action="Mantenimiento" class="btn btn-dark ms-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}