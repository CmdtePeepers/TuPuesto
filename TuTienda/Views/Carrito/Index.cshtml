@model IEnumerable<TuTienda.Models.Entities.CarritoItem>

@{
    ViewData["Title"] = "Mi Carrito";
    var porVendedor = Model.GroupBy(i => i.Producto?.Vendedor?.NombreTienda ?? i.Producto?.Vendedor?.Nombres ?? "Vendedor");
    decimal totalGeneral = Model.Sum(i => i.Cantidad * i.PrecioUnitario);
}

<style>
    .cart-vendedor {
        border: 1px solid #f0e2dc;
        border-radius: 10px;
        margin-bottom: 1.4rem;
        overflow: hidden;
    }

    .cart-vendedor-header {
        background: #FFF7F2;
        padding: 0.7rem 1.2rem;
        font-weight: 700;
        color: #A8172A;
        border-bottom: 1px solid #f0e2dc;
    }

    .cart-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.9rem 1.2rem;
        border-bottom: 1px solid #f5f5f5;
    }

        .cart-item img {
            width: 64px;
            height: 64px;
            object-fit: cover;
            border-radius: 6px;
            background: #f0f0f0;
        }

    .cart-item-info {
        flex: 1;
    }

    .cart-item-nombre {
        font-weight: 600;
    }

    .cart-item-precio {
        color: #6b6656;
        font-size: 0.9rem;
    }

    .cart-total {
        text-align: right;
        font-size: 1.3rem;
        font-weight: 700;
        color: #A8172A;
        margin: 1.5rem 0;
    }
</style>

<h1>Mi Carrito</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-light border">
        Tu carrito está vacío. <a asp-controller="Producto" asp-action="Index">Ver productos</a>
    </div>
}
else
{
    @foreach (var grupo in porVendedor)
    {
        <div class="cart-vendedor">
            <div class="cart-vendedor-header">Vendido por: @grupo.Key</div>
            @foreach (var item in grupo)
            {
                <div class="cart-item">
                    <img src="@(string.IsNullOrEmpty(item.Producto?.ImagenUrl) ? "https://via.placeholder.com/64" : item.Producto.ImagenUrl)" alt="@item.Producto?.Nombre" />
                    <div class="cart-item-info">
                        <div class="cart-item-nombre">@item.Producto?.Nombre</div>
                        <div class="cart-item-precio">S/ @item.PrecioUnitario.ToString("0.00") c/u</div>
                    </div>

                    <form asp-action="ActualizarCantidad" method="post" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <input type="number" name="cantidad" value="@item.Cantidad" min="1" class="form-control form-control-sm" style="width:70px;" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Actualizar</button>
                    </form>

                    <div style="min-width:90px; text-align:right; font-weight:600;">
                        S/ @((item.Cantidad * item.PrecioUnitario).ToString("0.00"))
                    </div>

                    <form asp-action="Eliminar" method="post">
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </div>
            }
        </div>
    }

    <div class="cart-total">Total: S/ @totalGeneral.ToString("0.00")</div>

    <a asp-controller="Producto" asp-action="Index" class="btn btn-outline-secondary">Seguir comprando</a>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-action="Checkout" class="btn btn-danger">Proceder al pago (simulado)</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Carrito")" class="btn btn-danger">
            Inicia sesión para pagar
        </a>
    }
}
