@model IEnumerable<TuTienda.Models.Entities.Pedido>

@{
    ViewData["Title"] = "Compra confirmada";
}

<style>
    .conf-header {
        text-align: center;
        padding: 2rem 1rem;
        margin-bottom: 2rem;
    }
    .conf-header .icono {
        font-size: 3rem;
        margin-bottom: 0.5rem;
    }
    .conf-pedido {
        border: 1px solid #f0e2dc;
        border-radius: 10px;
        margin-bottom: 1rem;
        overflow: hidden;
    }
    .conf-pedido-header {
        background: #FFF7F2;
        padding: 0.8rem 1.2rem;
        display: flex;
        justify-content: space-between;
        font-weight: 700;
        color: #A8172A;
    }
    .conf-item {
        padding: 0.6rem 1.2rem;
        border-top: 1px solid #f5f5f5;
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
    }
</style>

<div class="conf-header">
    <div class="icono">✅</div>
    <h1>¡Compra confirmada!</h1>
    <p class="text-muted">Se generaron @Model.Count() pedido(s), uno por cada vendedor.</p>
</div>

@foreach (var pedido in Model)
{
    <div class="conf-pedido">
        <div class="conf-pedido-header">
            <span>Pedido #@pedido.Id — @(pedido.Vendedor?.NombreTienda ?? pedido.Vendedor?.Nombres)</span>
            <span>S/ @pedido.Total.ToString("0.00")</span>
        </div>
        @foreach (var detalle in pedido.Detalles)
        {
            <div class="conf-item">
                <span>@detalle.Producto?.Nombre × @detalle.Cantidad</span>
                <span>S/ @detalle.Subtotal.ToString("0.00")</span>
            </div>
        }
        <div class="conf-item">
            <span>Estado</span>
            <span><strong>@pedido.Estado</strong></span>
        </div>
    </div>
}

<a asp-controller="Producto" asp-action="Index" class="btn btn-danger">Seguir comprando</a>
